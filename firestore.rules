rules_version = '2';
// Regole di sicurezza del registro chiavi e della lavorazione usato Dag Auto.
// Entra solo chi ha verificato la propria email ED è presente nell'elenco "utenti".
// Ruoli: admin, backoffice, usato (responsabile usato), productexpert, venditore, movimentatore, officina,
// ripristini, preparatore, foto, operatore (solo chiavi).
// Il carico fiscale (usato_riservato) lo vedono solo admin, backoffice e usato.
// Lo storico movimenti si può solo aggiungere: nessuno può modificarlo o cancellarlo.
service cloud.firestore {
  match /databases/{database}/documents {

    function emailUtente() {
      return request.auth.token.email.lower();
    }
    function autorizzato() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/utenti/$(emailUtente()));
    }
    function ruolo() {
      return get(/databases/$(database)/documents/utenti/$(emailUtente())).data.ruolo;
    }
    function admin() {
      return autorizzato() && ruolo() == "admin";
    }
    function lavoraUsato() {
      return autorizzato() && ruolo() != "operatore";
    }
    function vedeFiscale() {
      return autorizzato() && ruolo() in ["admin", "backoffice", "usato"];
    }
    function gestione() {
      return autorizzato() && ruolo() in ["admin", "backoffice", "usato"];
    }
    function vuota(d) {
      return d.get("telaio", "") == "" && d.get("targa", "") == "" && d.get("modello", "") == "";
    }
    function chiaveValida() {
      return request.resource.data.colore in ["BLU", "ROSSO", "VERDE"]
        && request.resource.data.numero is int
        && request.resource.data.numero >= 1 && request.resource.data.numero <= 100
        && request.resource.data.updatedBy == emailUtente();
    }
    function cambia() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function statoIn(l) {
      return request.resource.data.get("stato", "") == resource.data.get("stato", "") || request.resource.data.get("stato", "") in l;
    }

    // Tutti inseriscono vetture e lavorano sulle chiavi. Liberare il numero (vettura uscita): solo gestione e venditori.
    // Venditori e product expert su una vettura presente possono solo spostarla.
    match /chiavi/{id} {
      allow read: if autorizzato();
      allow create: if autorizzato() && chiaveValida();
      allow update: if autorizzato() && chiaveValida()
        && (vuota(resource.data) || !vuota(request.resource.data) || ruolo() in ["admin", "backoffice", "usato", "venditore", "productexpert"])
        && (!(ruolo() in ["venditore", "productexpert", "bdc"]) || vuota(resource.data) || vuota(request.resource.data)
            || cambia().hasOnly(["dovePrima", "prima", "noleggioDal", "noleggioCliente", "ripristino", "ripristinoTipo", "ripristinoDove", "ripristinoDal", "updatedAt", "updatedBy"]));
      allow delete: if admin();
    }

    match /usato/{id} {
      allow read: if lavoraUsato();
      allow create: if vedeFiscale() && request.resource.data.updatedBy == emailUtente();
      // Gestione: tutto. Officina e ripristini: voci e stati «in ripristino» / «pronta».
      // Movimentatore, foto, venditori: solo lo stato, ognuno i suoi.
      allow update: if lavoraUsato() && request.resource.data.updatedBy == emailUtente()
        && (gestione()
          || (ruolo() in ["officina", "ripristini"] && statoIn(["ripristino", "pronta"]))
          || (cambia().hasOnly(["stato", "date", "updatedAt", "updatedBy"])
              && ((ruolo() == "movimentatore" && statoIn(["ripristino", "pronta", "foto"]))
                || (ruolo() == "foto" && statoIn(["foto"]))
                || (ruolo() in ["venditore", "productexpert"] && statoIn(["pubblicata"])))));
      allow delete: if admin();
    }

    match /usato_riservato/{id} {
      allow read, create, update: if vedeFiscale();
      allow delete: if admin();
    }

    match /consegne/{id} {
      allow read: if lavoraUsato();
      allow create: if gestione() && request.resource.data.updatedBy == emailUtente();
      allow update: if lavoraUsato() && request.resource.data.updatedBy == emailUtente();
      allow delete: if admin();
    }

    // Impegni / appuntamenti: li vedono gestione e venditori; li scrivono il product expert (i suoi) e la gestione.
    match /impegni/{id} {
      allow read: if autorizzato() && ruolo() in ["admin", "backoffice", "usato", "venditore", "productexpert", "bdc"];
      allow create: if autorizzato() && request.resource.data.updatedBy == emailUtente()
        && ((ruolo() == "productexpert" && request.resource.data.email == emailUtente()) || gestione());
      allow update: if autorizzato() && request.resource.data.updatedBy == emailUtente()
        && ((ruolo() == "productexpert" && resource.data.email == emailUtente() && request.resource.data.email == emailUtente()) || gestione());
      allow delete: if autorizzato() && ((ruolo() == "productexpert" && resource.data.email == emailUtente()) || gestione());
    }

    match /storico/{id} {
      allow read: if gestione();
      allow create: if autorizzato();
      allow update, delete: if admin();
    }

    match /notifiche_coda/{id} {
      allow create: if autorizzato() && request.resource.data.inviata == false;
      allow read: if admin();
      allow update, delete: if false;
    }

    match /notifiche_utenti/{email} {
      allow read, write: if autorizzato() && email == emailUtente();
      allow read: if admin();
    }

    match /movimenti/{id} {
      allow read: if autorizzato();
      allow create: if autorizzato() && request.resource.data.email == emailUtente();
      allow update, delete: if false;
    }

    match /utenti/{email} {
      allow read: if autorizzato();
      allow write: if admin();
    }
  }
}
